{
  "name": "kingscare-nimasa-mockup",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:api": "node --experimental-sqlite --import tsx server/index.ts",
    "dev:web": "vite --host",
    "dev": "concurrently -n API,WEB -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "seed": "node --experimental-sqlite --import tsx server/seed.ts",
    "db:reset": "node --experimental-sqlite --import tsx server/reset.ts",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "build": "tsc && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.7",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
